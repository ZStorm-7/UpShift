{
  "expo": {
    "name": "UpShift",
    "slug": "upshift",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "upshift",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0F1720",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.upshift.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "UpShift needs access to your photos so you can set a profile picture."
      }
    },
    "android": {
      "package": "com.upshift.app",
      "adaptiveIcon": {
        "backgroundColor": "#0F1720",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "UpShift needs access to your photos so you can set a profile picture."
        }
      ],
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "UpShift needs camera access so you can scan a food's barcode instead of typing it in.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0F1720"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "87575022-512f-4afd-a9c8-8eddf9226f2e"
      }
    },
    "owner": "zstorm"
  }
}
