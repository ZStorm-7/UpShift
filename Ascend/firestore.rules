rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Shared helpers for the direct-message rules below ----
    //
    // A conversation's id is ALWAYS "<uidA>_<uidB>" with the two uids sorted
    // (see firebase/messages.ts's conversationIdFor) — so unlike every other
    // collection in this file, membership here is checked by splitting the
    // document id itself rather than by reading a `participants` field. That
    // means a message's read/write rule never needs a `get()` on its parent
    // conversation doc just to find out who's allowed to touch it.
    function dmUids(conversationId) {
      return conversationId.split('_');
    }
    function isDmParticipant(conversationId) {
      return request.auth.uid in dmUids(conversationId);
    }
    function otherDmUid(conversationId) {
      return dmUids(conversationId)[0] == request.auth.uid ? dmUids(conversationId)[1] : dmUids(conversationId)[0];
    }
    // "has `blockerUid` blocked `maybeBlockedUid`" — reads the BLOCKER's own
    // meta/social doc via `get()`, which (unlike a normal client read) isn't
    // subject to that doc's own users/{uid} rule, so this can answer the
    // question even though the sender could never read the recipient's
    // private doc directly. `blockedUids` is optional on that doc (most
    // users have never blocked anyone), so the `'blockedUids' in ...`
    // guard comes first — evaluating `x in <missing field>` throws and
    // fails the whole rule closed instead of just this clause.
    function isBlockedBy(blockerUid, maybeBlockedUid) {
      return exists(/databases/$(database)/documents/users/$(blockerUid)/meta/social)
        && ('blockedUids' in get(/databases/$(database)/documents/users/$(blockerUid)/meta/social).data)
        && maybeBlockedUid in get(/databases/$(database)/documents/users/$(blockerUid)/meta/social).data.blockedUids;
    }
    // "does `uid` list `friendUid` as a friend" — same privileged-read
    // reasoning as isBlockedBy, used so DMs can be gated to friends
    // server-side and not just by the client choosing to call
    // getOrCreateConversation.
    function isFriendOf(uid, friendUid) {
      return exists(/databases/$(database)/documents/users/$(uid)/meta/social)
        && ('friendUids' in get(/databases/$(database)/documents/users/$(uid)/meta/social).data)
        && friendUid in get(/databases/$(database)/documents/users/$(uid)/meta/social).data.friendUids;
    }
    // Checked in EITHER direction — the accept/sync handshake documented in
    // firebase/friends.ts means there's a real window where one side's
    // friendUids already has the other but the reverse hasn't synced yet,
    // and a DM shouldn't be refused just because of which side happens to
    // be ahead.
    function areDmFriends(uidA, uidB) {
      return isFriendOf(uidA, uidB) || isFriendOf(uidB, uidA);
    }

    // ---- Private per-user data ----
    // Everything under users/{uid} is readable and writable ONLY by that user.
    // The nested {document=**} wildcard covers every subcollection at once —
    // days/{dayId}, meta/stats, meta/quests, meta/streak, meta/weightLog,
    // meta/customFoods — so adding a new subcollection later can't silently
    // fall through to the deny-all rule at the bottom, which is exactly the
    // bug that broke XP saving when meta/ was first introduced.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ---- Public leaderboard ----
    // A leaderboard fundamentally requires reading other people's rows, so
    // this collection is readable by any signed-in user. Writes stay locked to
    // the owner: the document ID must equal the writer's uid, making it
    // impossible to edit someone else's score or invent an entry under a uid
    // that isn't yours.
    //
    // This is why the leaderboard is a SEPARATE top-level collection rather
    // than a field on the user document — opening up the user document would
    // expose weight, age, meals and everything else along with it.
    // The document ID check alone is not enough, which is subtle enough to be
    // worth spelling out. The row also CONTAINS a `uid` field, and the client
    // uses that field — not the document ID — to find "your position". So a
    // user could write their own row with someone else's uid inside it, and
    // the old rule would happily accept it: the victim would open the
    // Leaderboard and see the attacker's fabricated score presented as their
    // own standing, with their real row nowhere to be found.
    //
    // hasOnly() pins the shape so no extra fields can be smuggled in, and the
    // type/range checks stop a hand-crafted request from writing totalXP as a
    // string (which would break the orderBy) or as a negative number.
    //
    // What this still does NOT do is prove the score is honest — a determined
    // user can write a well-formed but inflated total for themselves. Making
    // that impossible needs a server-side write (a Cloud Function mirroring
    // meta/stats), which the no-cost plan won't run.
    match /leaderboard/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.keys().hasOnly(
             ['uid', 'displayName', 'avatar', 'avatarColor', 'bio', 'level', 'totalXP', 'rank', 'streak'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 40
        && request.resource.data.avatar is string
        && request.resource.data.avatar.size() <= 300
        // avatarColor is new and optional — hasOnly() above already allows a
        // document that omits it, this just makes sure that WHEN it's present
        // it can't be smuggled in as some other type or an arbitrarily long
        // string (it's only ever one of 7 short hex codes from
        // theme/colors.ts's avatarPalette, but rules can't reference app
        // code, so the bound here is a generous "any hex-length string").
        && (!('avatarColor' in request.resource.data)
            || (request.resource.data.avatarColor is string
                && request.resource.data.avatarColor.size() <= 9))
        // bio is optional too, same reasoning — LeaderboardEntry.bio was
        // added on the client (DashboardScreen's publishToLeaderboard) but
        // this hasOnly() list was never updated to match, so every publish
        // for anyone who'd ever written a bio was rejected outright
        // (permission-denied) and silently swallowed by that call's own
        // .catch(() => {}), freezing their entire leaderboard row — level,
        // streak, XP, name, avatar — at whatever it was before. 200 matches
        // EditProfileScreen/SettingsScreen's own maxLength on the bio field.
        && (!('bio' in request.resource.data)
            || (request.resource.data.bio is string
                && request.resource.data.bio.size() <= 200))
        && request.resource.data.rank is string
        && request.resource.data.level is int
        && request.resource.data.level >= 1
        && request.resource.data.totalXP is int
        && request.resource.data.totalXP >= 0
        && request.resource.data.streak is int
        && request.resource.data.streak >= 0;
    }

    // ---- Onboarding drop-off events (write-only) ----
    // A flat log of step-view/complete/abandon events, one document per
    // event. Nobody ever reads this from the client — not even their own
    // events back — so `allow read: if false` here is deliberate, not an
    // oversight: there is no product feature that needs it, and every read
    // path removed is one less thing that can leak. Whoever wants the
    // funnel numbers queries this collection directly from the Firebase
    // console or an export, using an account with elevated (non-rules-
    // governed) access.
    match /onboardingEvents/{eventId} {
      allow read: if false;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.eventType in ['step_view', 'onboarding_complete', 'onboarding_abandoned']
        && request.resource.data.step is int
        && request.resource.data.keys().hasOnly(['uid', 'step', 'eventType', 'at']);
      allow update, delete: if false;
    }

    // ---- Friend codes: public code -> uid lookup ----
    // A short shareable code is how one user finds another to friend, since
    // there's no username system and email lookup would leak who has an
    // account. The code itself carries no personal info, so it's safe for
    // any signed-in user to resolve.
    //
    // `allow create` only ever fires when the code doesn't already exist —
    // that's what distinguishes a Firestore "create" from an "update" — so
    // this is also what stops one user from overwriting someone else's
    // claimed code. Once set, a code is permanent (no update/delete): a
    // user who wants a different code gets a new one issued to them by the
    // app instead of releasing the old one, which would let a second person
    // claim a code that got shared with the wrong intent.
    match /friendCodes/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid']);
      allow update, delete: if false;
    }

    // ---- Friend requests ----
    // A pending/accepted/rejected request between two users. Read access is
    // restricted to the two people involved — everyone else gets nothing,
    // including for a plain `list` query, since Firestore evaluates this
    // rule per matched document and a query filtered to `toUid == me` or
    // `fromUid == me` can never surface a document that fails it.
    //
    // Only the recipient can move status out of 'pending', and only into
    // 'accepted' or 'rejected' — a sender can't self-approve their own
    // request by writing the field directly. Either side can delete a
    // request outright, covering "cancel one I sent" and "remove one I
    // already accepted."
    match /friendRequests/{requestId} {
      allow read: if request.auth != null
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(
             ['fromUid', 'toUid', 'fromDisplayName', 'fromAvatarColor', 'status', 'createdAt'])
        && request.resource.data.fromDisplayName is string
        && request.resource.data.fromDisplayName.size() <= 40;
      allow update: if request.auth != null
        && resource.data.toUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['accepted', 'rejected'];
      allow delete: if request.auth != null
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
    }

    // ---- Leaderboard reactions ----
    // A subcollection under each leaderboard row: one document per reactor,
    // keyed by their own uid, so tapping the same emoji again or a
    // different one is a plain overwrite rather than needing separate
    // add/remove logic. Public read (like the leaderboard row it hangs
    // off), but a reactor can only ever write the document whose ID is
    // their own uid — never anyone else's reaction.
    match /leaderboard/{userId}/reactions/{reactorUid} {
      allow read: if request.auth != null;
      // Split from a single `allow write`, deliberately: on a delete,
      // `request.resource` is null, so a combined rule that reads
      // `request.resource.data.*` would throw on evaluation and silently
      // deny every attempt to clear a reaction — the write-only-checks-
      // create-and-update version of this rule looked right and would have
      // made clearReaction() permanently broken.
      allow create, update: if request.auth != null
        && request.auth.uid == reactorUid
        && request.resource.data.uid == reactorUid
        && request.resource.data.emoji is string
        && request.resource.data.emoji.size() <= 8
        && request.resource.data.keys().hasOnly(['uid', 'emoji']);
      allow delete: if request.auth != null && request.auth.uid == reactorUid;
    }

    // ---- Challenges ----
    // A friendly, opt-in 1-on-1 competition between two people who already
    // agreed to be friends. Both participants can read and update the full
    // document, including each other's score field — this is intentionally
    // more trusting than the leaderboard's per-field locking, because a
    // challenge only ever involves two people who chose each other, unlike
    // the leaderboard's read-by-everyone shared ranking. Same trust model
    // this app already documents for XP generally (no server to referee
    // it on the free plan): a participant COULD write a flattering score
    // for themselves, same as they could on any client-trusted field
    // elsewhere in this app.
    match /challenges/{challengeId} {
      allow read, update, delete: if request.auth != null
        && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.keys().hasOnly(
             ['createdBy', 'participants', 'goalType', 'goalLabel', 'startDate', 'endDate',
              'status', 'scores', 'winnerUid', 'createdAt']);
    }

    // ---- Direct messages: conversations ----
    // One doc per friend pair, id-derived (see dmUids above). The create/
    // update rules below still enforce that invariant — `participants`
    // always equals dmUids(conversationId) — but the READ rule can't rely on
    // the id-derived check alone: MessagesScreen lists every conversation a
    // user is in with a single collection query
    // (`where('participants', 'array-contains', uid)`, see
    // subscribeToConversations), and Firestore can only grant a `list` query
    // by evaluating the rule against each matched document's DATA — it has
    // no conversationId to parse yet since the whole point of the query is
    // to discover which ids exist. A rule that only ever inspects the path
    // segment denies every list query outright (confirmed: it did, with
    // "Missing or insufficient permissions", leaving Messages stuck on its
    // loading skeleton forever — subscribeToConversations's onSnapshot has
    // no error handler, so the failure was otherwise silent). Checking
    // resource.data.participants directly is what makes the list query
    // legible to the rules engine; isDmParticipant is kept as a second,
    // redundant condition for the direct-by-id get() case, which is not
    // required to type as an array-contains match at rule-evaluation time.
    match /conversations/{conversationId} {
      allow read: if request.auth != null
        && (isDmParticipant(conversationId) || request.auth.uid in resource.data.participants);
      allow create: if request.auth != null
        && isDmParticipant(conversationId)
        && dmUids(conversationId).size() == 2
        && request.resource.data.participants == dmUids(conversationId)
        && request.resource.data.keys().hasOnly(
             ['participants', 'lastMessage', 'lastMessageAt', 'lastMessageSenderId', 'lastReadAt'])
        && request.resource.data.lastReadAt is map
        // Only a friend of the OTHER participant may open a new DM thread —
        // enforced here (not just client-side in getOrCreateConversation) so
        // a stranger can't message someone by hand-crafting this write.
        && areDmFriends(dmUids(conversationId)[0], dmUids(conversationId)[1]);
      allow update: if request.auth != null
        && isDmParticipant(conversationId)
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.keys().hasOnly(
             ['participants', 'lastMessage', 'lastMessageAt', 'lastMessageSenderId', 'lastReadAt']);
      allow delete: if false;
    }

    // ---- Direct messages: messages ----
    // A message can only be CREATED by the participant it claims as its
    // sender, and only if the recipient — the other uid embedded in
    // conversationId — hasn't blocked them. This is the one rule in this
    // file that has to reach outside the document being written to check
    // another user's private data, which is exactly what `get()` in a rule
    // is for: it's a privileged read used to evaluate the rule, not a grant
    // of read access to the sender.
    //
    // Delete/unsend is a SOFT delete (see firebase/messages.ts's
    // deleteMessage) — only the sender may flip `deleted` to true and blank
    // `text`, and every other field is frozen once written, including
    // `senderId` and `createdAt`, so a delete can't be reused to rewrite
    // history.
    match /conversations/{conversationId}/messages/{messageId} {
      allow read: if request.auth != null && isDmParticipant(conversationId);
      allow create: if request.auth != null
        && isDmParticipant(conversationId)
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.deleted == false
        && request.resource.data.keys().hasOnly(['senderId', 'text', 'createdAt', 'deleted'])
        && !isBlockedBy(otherDmUid(conversationId), request.auth.uid)
        // Same friends-only gate as the conversation doc's create rule,
        // repeated here because a message can be written into this
        // subcollection whether or not the parent conversation doc exists
        // yet — without this, that ordering gap would be a way around the
        // conversation-create check above.
        && areDmFriends(dmUids(conversationId)[0], dmUids(conversationId)[1]);
      allow update: if request.auth != null
        && resource.data.senderId == request.auth.uid
        && request.resource.data.senderId == resource.data.senderId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.deleted == true
        && request.resource.data.text == ''
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted', 'text']);
      allow delete: if false;
    }

    // ---- Reports ----
    // Create-only, deliberately mirroring onboardingEvents' write-only shape
    // below: a report is meant to be reviewed by whoever administers the
    // project directly, not read back by any client, including the
    // reporter's own.
    match /reports/{reportId} {
      allow read, update, delete: if false;
      allow create: if request.auth != null
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.reportedUid is string
        && request.resource.data.reportedUid != request.auth.uid
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 500
        && request.resource.data.keys().hasOnly(['reportedUid', 'reporterUid', 'reason', 'createdAt']);
    }

    // ---- Crash reports ----
    // Written by components/ErrorBoundary.tsx whenever a render-phase error
    // is caught, so "our team has been notified" on the maintenance screen
    // is literally true. Create-only, same write-only shape as `reports`
    // above — nobody reviews these from inside the app.
    //
    // Unlike every other collection in this file, signed-out writes are
    // allowed: a crash can happen on the Welcome/Auth screen before anyone
    // has signed in, and THAT crash is exactly the kind worth capturing,
    // not one to silently drop because auth.currentUser was null.
    match /crashReports/{reportId} {
      allow read, update, delete: if false;
      allow create: if
        // Either genuinely signed out (uid: null), or the uid claimed
        // matches whoever is actually making the request — never someone
        // else's.
        (request.resource.data.uid == null || request.resource.data.uid == request.auth.uid)
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 1000
        && request.resource.data.stack is string
        && request.resource.data.stack.size() <= 2000
        && request.resource.data.componentStack is string
        && request.resource.data.componentStack.size() <= 2000
        && request.resource.data.platform is string
        && request.resource.data.keys().hasOnly(
             ['uid', 'message', 'stack', 'componentStack', 'platform', 'createdAt']);
    }

    // ---- Deny everything else ----
    // Anything not explicitly allowed above is refused, so an unplanned or
    // typo'd collection path fails closed rather than open.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
