# Copy this file to `.env` (gitignored) and fill in real values locally.
# Never commit `.env` — see .gitignore.

# Google Gemini API key, used by services/foodRecognition.ts for the
# Nutrition screen's "Picture" tab (photo recognition) AND the Manual tab's
# "Describe your meal" text recognition. Free tier available, as of this
# writing with no billing account required.
#   1. Sign in at https://aistudio.google.com/apikey with a Google account.
#   2. Click "Create API key" and copy it.
#   3. Paste it below, then restart `expo start` to pick it up.
EXPO_PUBLIC_GEMINI_API_KEY=

# Optional: override the Gemini model id services/foodRecognition.ts calls,
# without a code change, if Google renames/retires the default
# (gemini-2.5-flash as of this writing).
EXPO_PUBLIC_GEMINI_MODEL=

# Google Sign-In, used by screens/AuthScreen.tsx via expo-auth-session's
# dedicated Google.useIdTokenAuthRequest provider. NOTE: Expo's current docs
# mark this convenience wrapper "@deprecated" in favor of the heavier native
# @react-native-google-signin/google-signin module — it's used here anyway,
# deliberately, to avoid that module's native linking step; see the comment
# above the Google Sign-In imports in AuthScreen.tsx. The wrapper handles its
# own redirect URI internally, so no manual AuthSession.makeRedirectUri/
# discovery-document setup is needed. Without these three vars set, the
# Google button hides itself instead of crashing.
#
# How to get them, as the app's developer (one-time setup):
#   1. Go to https://console.cloud.google.com/apis/credentials (create/select
#      the project tied to this Firebase project — Firebase projects are
#      backed by a GCP project of the same id, "upshift-3ec69").
#   2. Click "Create Credentials" -> "OAuth client ID" and create THREE
#      clients, one per platform:
#      - Web application -> paste its Client ID below as
#        EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID.
#      - iOS -> Bundle ID com.upshift.app -> paste as
#        EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID.
#      - Android -> Package name com.upshift.app, plus the SHA-1 signing
#        certificate fingerprint for your build (get it from
#        `eas credentials` or your keystore) -> paste as
#        EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID.
#   3. In the Firebase console: Authentication -> Sign-in method -> enable
#      the "Google" provider.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
