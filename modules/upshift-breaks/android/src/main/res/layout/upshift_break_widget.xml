<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/upshift_widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/upshift_widget_bg"
  android:gravity="center_vertical"
  android:orientation="vertical"
  android:padding="14dp">

  <TextView
    android:id="@+id/upshift_widget_title"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:maxLines="1"
    android:text="@string/upshift_widget_title"
    android:textColor="#99F2F7F5"
    android:textSize="11sp"
    android:textStyle="bold" />

  <TextView
    android:id="@+id/upshift_widget_value"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:ellipsize="end"
    android:maxLines="2"
    android:textColor="#FFF2F7F5"
    android:textSize="26sp"
    android:textStyle="bold" />

  <TextView
    android:id="@+id/upshift_widget_sub"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:ellipsize="end"
    android:maxLines="1"
    android:textColor="#FF00C805"
    android:textSize="12sp" />
</LinearLayout>
