<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/upshift_progress_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/upshift_widget_bg"
  android:orientation="vertical"
  android:padding="14dp">

  <TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:maxLines="1"
    android:text="@string/upshift_progress_title"
    android:textColor="#99F2F7F5"
    android:textSize="11sp"
    android:textStyle="bold" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:orientation="horizontal">
    <TextView
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:maxLines="1"
      android:text="@string/upshift_progress_quests"
      android:textColor="#CCF2F7F5"
      android:textSize="13sp" />
    <TextView
      android:id="@+id/upshift_progress_quests"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:maxLines="1"
      android:textColor="#FFF2F7F5"
      android:textSize="15sp"
      android:textStyle="bold" />
  </LinearLayout>
  <ProgressBar
    android:id="@+id/upshift_progress_quests_bar"
    style="?android:attr/progressBarStyleHorizontal"
    android:layout_width="match_parent"
    android:layout_height="4dp"
    android:layout_marginTop="3dp"
    android:max="100"
    android:progressTint="#FF00C805" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:orientation="horizontal">
    <TextView
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:maxLines="1"
      android:text="@string/upshift_progress_water"
      android:textColor="#CCF2F7F5"
      android:textSize="13sp" />
    <TextView
      android:id="@+id/upshift_progress_water"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:maxLines="1"
      android:textColor="#FFF2F7F5"
      android:textSize="15sp"
      android:textStyle="bold" />
  </LinearLayout>
  <ProgressBar
    android:id="@+id/upshift_progress_water_bar"
    style="?android:attr/progressBarStyleHorizontal"
    android:layout_width="match_parent"
    android:layout_height="4dp"
    android:layout_marginTop="3dp"
    android:max="100"
    android:progressTint="#FF4BA3E3" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:orientation="horizontal">
    <TextView
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:maxLines="1"
      android:text="@string/upshift_progress_streak"
      android:textColor="#CCF2F7F5"
      android:textSize="13sp" />
    <TextView
      android:id="@+id/upshift_progress_streak"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:maxLines="1"
      android:textColor="#FFF2F7F5"
      android:textSize="15sp"
      android:textStyle="bold" />
  </LinearLayout>

  <TextView
    android:id="@+id/upshift_progress_note"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:ellipsize="end"
    android:maxLines="1"
    android:textColor="#FF00C805"
    android:textSize="11sp" />
</LinearLayout>
