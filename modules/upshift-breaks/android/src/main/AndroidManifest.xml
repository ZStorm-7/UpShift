<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">

  <!-- Mindful breaks: see which app is in front (user grants this in Settings > Usage access). -->
  <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
  <!-- Lets the break come to the front when the user is in another app. -->
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

  <!-- Lets the app list launchable apps without the broad QUERY_ALL_PACKAGES permission. -->
  <queries>
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.LAUNCHER" />
    </intent>
  </queries>

  <application>
    <service
      android:name=".BreakMonitorService"
      android:exported="false"
      android:foregroundServiceType="specialUse">
      <property
        android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
        android:value="Checks which app is in the foreground so a short breathing break can start after the user's chosen time in apps they selected" />
    </service>

    <!-- Home-screen widget: time until the next break. -->
    <receiver android:name=".BreakWidgetProvider" android:exported="true" android:label="@string/upshift_widget_title">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/upshift_break_widget_info" />
    </receiver>

    <!-- Home-screen widget: today's quests, water and streak. -->
    <receiver android:name=".ProgressWidgetProvider" android:exported="true" android:label="@string/upshift_progress_title">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/upshift_progress_widget_info" />
    </receiver>

    <receiver android:name=".BootReceiver" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
      </intent-filter>
    </receiver>
  </application>
</manifest>
